# Backend API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this frontend deployment — used for sitemap.xml, robots.txt,
# and Open Graph/Twitter Card absolute URLs. Like other NEXT_PUBLIC_* vars,
# changing it requires a full redeploy, not just a save.
NEXT_PUBLIC_SITE_URL=https://amakuru.news

# Firebase — used for Cloud Messaging (push notifications) only.
# Authentication no longer uses Firebase; sign-in/sign-up go through the
# backend's custom JWT endpoints instead.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
